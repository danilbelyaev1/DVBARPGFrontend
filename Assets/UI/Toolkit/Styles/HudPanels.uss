.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-start;
    align-items: flex-start;
    background-color: rgba(0, 0, 0, 0);
}

.hud-panel {
    min-width: 520px;
    max-width: 880px;
    max-height: 760px;
    padding: 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(20, 22, 28, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.16);
    border-right-color: rgba(255, 255, 255, 0.16);
    border-top-color: rgba(255, 255, 255, 0.16);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    margin-left: 16px;
    margin-top: 80px;
}

.hud-root-left {
    justify-content: flex-start;
    align-items: flex-start;
}

.hud-root-right {
    justify-content: flex-start;
    align-items: flex-end;
}

.hud-root-right .hud-panel {
    margin-left: 0;
    margin-right: 16px;
}

.hud-title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: rgb(236, 238, 242);
}

.hud-subtitle {
    font-size: 15px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 6px;
    color: rgb(214, 219, 229);
}

.hud-status {
    margin-top: 8px;
    color: rgb(172, 179, 193);
}

.hud-list {
    flex-grow: 1;
    min-height: 180px;
}

.hud-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(45, 49, 61, 0.9);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.hud-button {
    min-height: 34px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.hud-split {
    flex-direction: row;
    gap: 12px;
}

.hud-column {
    flex-grow: 1;
}

.hud-quest-section {
    margin-top: 8px;
}

.hud-quest-list {
    max-height: 220px;
}

.hud-quest-item {
    margin-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgba(45, 49, 61, 0.9);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.hud-quest-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(236, 238, 242);
}

.hud-quest-meta {
    margin-top: 2px;
    color: rgb(184, 191, 205);
}

.hud-compact-panel {
    min-width: 360px;
    max-width: 420px;
}
